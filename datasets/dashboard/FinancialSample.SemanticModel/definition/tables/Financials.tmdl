		lineageTag: 32185cf7-5e3a-55b4-9639-f09801865722
		summarizeBy: none
		sourceColumn: COGS

	column Profit
		dataType: double
		formatString: \$#,0
		lineageTag: 1cb9cfa6-a8d5-5f8b-b7fa-303a6919d4df
		summarizeBy: none
		sourceColumn: Profit

	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 73f39e5e-35c7-5d9b-ad87-a37a818ac1ef
