	column Quarter
		dataType: string
		lineageTag: 1792f249-c08b-562c-b6de-b300f9df4775
		summarizeBy: none
		sourceColumn: [Quarter]

	partition Dim_Date = calculated
		source = ADDCOLUMNS(CALENDAR(DATE(2013, 9, 1), DATE(2014, 12, 31)), "Year", YEAR([Date]), "Month Number", MONTH([Date]), "Month Name", FORMAT([Date], "mmmm"), "Month Year", FORMAT([Date], "mmm yyyy"), "Month Year Index", YEAR([Date]) * 100 + MONTH([Date]), "Quarter", "Q" & QUARTER([Date]))

